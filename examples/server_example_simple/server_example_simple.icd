	<DataTypeTemplates>
		<LNodeType id="SampleIEDDevice1.LLN0" lnClass="LLN0">
			<DO name="Mod" type="SampleIEDDevice1.LLN0.Mod" />
			<DO name="Beh" type="SampleIEDDevice1.LLN0.Beh" />
			<DO name="Health" type="SampleIEDDevice1.LLN0.Health" />
			<DO name="NamPlt" type="SampleIEDDevice1.LLN0.NamPlt" />
		</LNodeType>
		<LNodeType id="SampleIEDDevice1.LPHD1" lnClass="LPHD">
			<DO name="PhyHealth" type="SampleIEDDevice1.LLN0.Health" />
			<DO name="Proxy" type="SampleIEDDevice1.LPHD1.Proxy" />
			<DO name="PhyNam" type="SampleIEDDevice1.LPHD1.PhyNam" />
		</LNodeType>
		<LNodeType id="SampleIEDDevice1.MMXU1" lnClass="MMXU">
			<DO name="Mod" type="SampleIEDDevice1.LLN0.Mod" />
