			<DO name="Beh" type="SampleIEDDevice1.LLN0.Beh" />
			<DO name="Health" type="SampleIEDDevice1.LLN0.Health" />
			<DO name="NamPlt" type="SampleIEDDevice1.DGEN1.NamPlt" />
		</LNodeType>
		<LNodeType id="SampleIEDDevice1.DGEN1" lnClass="DGEN">
			<DO name="TotWh" type="SampleIEDDevice1.DGEN1.TotWh" />
			<DO name="Mod" type="SampleIEDDevice1.DGEN1.Mod" />
			<DO name="Beh" type="SampleIEDDevice1.DGEN1.Beh" />
			<DO name="Health" type="SampleIEDDevice1.DGEN1.Health" />
			<DO name="OpTmh" type="SampleIEDDevice1.DGEN1.OpTmh" />
			<DO name="GnOpSt" type="SampleIEDDevice1.DGEN1.GnOpSt" />
			<DO name="OpTmsRs" type="SampleIEDDevice1.DGEN1.OpTmh" />
			<DO name="NamPlt" type="SampleIEDDevice1.DGEN1.NamPlt" />
