			<DO name="SchdAbsTm" type="SampleIEDDevice1.DSCH1.SchdAbsTm" />
		</LNodeType>
		<DOType id="SampleIEDDevice1.LPHD1.PhyNam" cdc="DPL">
			<DA name="vendor" fc="DC" bType="VisString255" />
		</DOType>
		<DOType id="SampleIEDDevice1.LLN0.Mod" cdc="INC">
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
			<DA name="ctlModel" fc="CF" bType="Enum" type="ctlModel" />
		</DOType>
		<DOType id="SampleIEDDevice1.LLN0.Beh" cdc="INS">
			<DA name="stVal" fc="ST" bType="Enum" type="Beh" />
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.LLN0.Health" cdc="INS">
			<DA name="stVal" fc="ST" bType="Enum" type="Health" />
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.DGEN1.OpTmh" cdc="INS">
			<DA name="stVal" fc="ST" bType="INT32" />
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.LLN0.NamPlt" cdc="LPL">
			<DA name="vendor" fc="DC" bType="VisString255" />
			<DA name="swRev" fc="DC" bType="VisString255" />
			<DA name="d" fc="DC" bType="VisString255" />
			<DA name="configRev" fc="DC" bType="VisString255" />
			<DA name="ldNs" fc="EX" bType="VisString255" />
		</DOType>
		<DOType id="SampleIEDDevice1.DGEN1.NamPlt" cdc="LPL">
			<DA name="vendor" fc="DC" bType="VisString255" />
			<DA name="swRev" fc="DC" bType="VisString255" />
			<DA name="d" fc="DC" bType="VisString255" />
		</DOType>
		<DOType id="SampleIEDDevice1.DGEN1.TotWh" cdc="MV">
			<DA name="mag" fc="MX" bType="Struct" type="SampleIEDDevice1.DGEN1.TotWh.mag" />
			<DA name="q" fc="MX" bType="Quality" />
			<DA name="t" fc="MX" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.LPHD1.Proxy" cdc="SPS">
			<DA name="stVal" fc="ST" bType="BOOLEAN" />
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.DGEN1.Mod" cdc="ENC">
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
			<DA name="ctlModel" fc="CF" bType="Enum" type="CtlModelKind" />
		</DOType>
		<DOType id="SampleIEDDevice1.DGEN1.Beh" cdc="ENS">
			<DA name="stVal" fc="ST" bType="Enum" type="Beh" />
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.DGEN1.Health" cdc="ENS">
			<DA name="stVal" fc="ST" bType="Enum" type="Health" />
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.DGEN1.GnOpSt" cdc="ENS">
			<DA name="stVal" fc="ST" bType="Enum" type="GnOpSt" />
			<DA name="q" fc="ST" bType="Quality" />
			<DA name="t" fc="ST" bType="Timestamp" />
		</DOType>
		<DOType id="SampleIEDDevice1.DSCH1.SchdAbsTm" cdc="SCA">
			<DA name="val" fc="SP" bType="FLOAT32" count="255" />
			<DA name="time" fc="SP" bType="Timestamp" count="255" />
		</DOType>
		<DAType id="SampleIEDDevice1.DGEN1.TotWh.mag">
			<BDA name="f" bType="FLOAT32" />
		</DAType>
		<EnumType id="ctlModel">
			<!--Source: IEC 61850-7-3:2003A-->
			<EnumVal ord="0">status-only</EnumVal>
			<EnumVal ord="1">direct-with-normal-security</EnumVal>
			<EnumVal ord="2">sbo-with-normal-security</EnumVal>
			<EnumVal ord="3">direct-with-enhanced-security</EnumVal>
			<EnumVal ord="4">sbo-with-enhanced-security</EnumVal>
		</EnumType>
		<EnumType id="CtlModelKind">
			<!--Source: IEC 61850-7-3:2007A-->
			<EnumVal ord="0">status-only</EnumVal>
			<EnumVal ord="1">direct-with-normal-security</EnumVal>
			<EnumVal ord="2">sbo-with-normal-security</EnumVal>
			<EnumVal ord="3">direct-with-enhanced-security</EnumVal>
			<EnumVal ord="4">sbo-with-enhanced-security</EnumVal>
		</EnumType>
		<EnumType id="Beh">
			<!--Source: IEC 61850-7-4:2003A-->
			<EnumVal ord="1">on</EnumVal>
			<EnumVal ord="2">blocked</EnumVal>
			<EnumVal ord="3">test</EnumVal>
			<EnumVal ord="4">test/blocked</EnumVal>
			<EnumVal ord="5">off</EnumVal>
		</EnumType>
		<EnumType id="Health">
			<!--Source: IEC 61850-7-4:2003A-->
			<EnumVal ord="1">Ok</EnumVal>
			<EnumVal ord="2">Warning</EnumVal>
			<EnumVal ord="3">Alarm</EnumVal>
		</EnumType>
		<EnumType id="GnOpSt">
			<!--Source: IEC 61850-7-420:2009A-->
			<EnumVal ord="0">Not applicable / Unknown</EnumVal>
			<EnumVal ord="1">Not operating</EnumVal>
			<EnumVal ord="2">Operating</EnumVal>
			<EnumVal ord="3">Starting up</EnumVal>
			<EnumVal ord="4">Shutting down</EnumVal>
			<EnumVal ord="5">At disconnect level</EnumVal>
			<EnumVal ord="6">Ramping (power)</EnumVal>
			<EnumVal ord="7">Ramping (reactive power)</EnumVal>
			<EnumVal ord="99">Other</EnumVal>
		</EnumType>
	</DataTypeTemplates>
</SCL>