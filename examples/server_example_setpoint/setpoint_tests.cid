<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL">
  <Header id="setpoint_tests" version="1.0.0" revision="A" toolID="hand-written" nameStructure="IEDName">
  </Header>
  <Communication>
    <SubNetwork name="subnetwork1" type="8-MMS">
      <ConnectedAP iedName="setpointIO" apName="accessPoint1">
        <Address>
          <P type="IP">0.0.0.0</P>
          <P type="IP-SUBNET">255.255.255.0</P>
          <P type="IP-GATEWAY">10.0.0.1</P>
          <P type="OSI-TSEL">0001</P>
          <P type="OSI-PSEL">00000001</P>
          <P type="OSI-SSEL">0001</P>
        </Address>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
  <IED name="setpointIO">
    <Services>
      <DynAssociation />
      <GetDirectory />
      <GetDataObjectDefinition />
      <GetDataSetValue />
      <DataSetDirectory />
      <ReadWrite />
      <GetCBValues />
      <ConfLNs fixPrefix="true" fixLnInst="true" />
    </Services>
    <AccessPoint name="accessPoint1">
      <Server>
        <Authentication />
        <LDevice inst="GenericIO">
          <LN0 lnClass="LLN0" lnType="LLN01" inst="">

            <!--
              数据集成员顺序 = 报告里元素的顺序，改顺序前先确认接收侧没按下标取值。
              成员一律指向叶子（mxVal.f / mag.f）而不是结构体本身：结构体会被摊成多个
              元素，索引含义随之改变。四个成员都是 FLOAT32，接收侧无需额外类型解析。
            -->
            <DataSet name="SetpointEvents" desc="遥调设定值与实际输出">
              <FCDA ldInst="GenericIO" lnClass="GGIO" fc="MX" lnInst="1" doName="AnOut1" daName="mxVal.f" />
              <FCDA ldInst="GenericIO" lnClass="GGIO" fc="MX" lnInst="1" doName="AnOut1Fb" daName="mag.f" />
              <FCDA ldInst="GenericIO" lnClass="GGIO" fc="MX" lnInst="1" doName="AnOut2" daName="mxVal.f" />
              <FCDA ldInst="GenericIO" lnClass="GGIO" fc="MX" lnInst="1" doName="AnOut2Fb" daName="mag.f" />
            </DataSet>

            <!--
              报告控制块 SetpointEvents

              TrgOps 五项全开 = 0x1F：
                dchg=1 qchg=2 dupd=4 integ=8 gi=16
                - 缺 gi    → 客户端写 GI=true 被静默忽略（启用成功却收不到全量）
                - 缺 integ → IntgPd 不排程，永远没有周期报告
              OptFields：seqNum/timeStamp/dataSet/reasonCode/entryID/configRef 全开 = 0xEF
                （bufOvfl 由生成器默认置位，非缓冲 RCB 下无影响）
                seqNum 用来判丢报，reasonCode 用来区分 变位/周期/全询，两个都别关。
                dataRef 是可选项，默认不加：数据集固定 4 个成员、接收侧按下标取值时它只是
                多占报文；需要"报告自带成员引用、模型改顺序也不用重对齐"时再打开
                （打开后 OptFlds 变 0xFF）。
              indexed="false"：
                生成器只在 indexed="true" 时才按 RptEnabled/max 生成 SetpointRCB01..N，
                那样客户端用的 setpointIOGenericIO/LLN0.RP.SetpointRCB 反而查不到对象。
                这里用单实例，RCB 名就是 SetpointRCB，引用可直接对上；
                同时生成器要求 indexed="false" 时 max 必须为 1，故 RptEnabled max="1"。
                若确实需要多客户端并发（每客户端一个 RCB 实例），改回 indexed="true" 并把
                max 调到 4，但客户端引用必须改用 SetpointRCB01..04。
              intgPd="1000"：只有 TrgOps 含 integ 时才排程；不需要周期报告请写 0
              bufTime="0"：非缓冲 RCB 下无实际作用，保留
            -->
            <ReportControl name="SetpointRCB" desc="遥调报告控制块" confRev="1" datSet="SetpointEvents"
                           rptID="SetpointEvents" buffered="false" intgPd="1000" bufTime="0" indexed="false">
              <TrgOps dchg="true" qchg="true" dupd="true" integ="true" gi="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true"
                         entryID="true" configRef="true" />
              <RptEnabled max="1" />
            </ReportControl>

            <DOI name="Mod">
              <DAI name="ctlModel">
                <Val>status-only</Val>
              </DAI>
            </DOI>
          </LN0>

          <LN lnClass="LPHD" lnType="LPHD1" inst="1" prefix="" />

          <LN lnClass="GGIO" lnType="GGIO1" inst="1" prefix="">
            <DOI name="Mod">
              <DAI name="ctlModel">
                <Val>status-only</Val>
              </DAI>
            </DOI>
            <DOI name="AnOut1">
              <DAI name="ctlModel">
                <Val>direct-with-enhanced-security</Val>
              </DAI>
            </DOI>
            <DOI name="AnOut2">
              <DAI name="ctlModel">
                <Val>direct-with-enhanced-security</Val>
              </DAI>
            </DOI>
          </LN>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>

  <DataTypeTemplates>
    <LNodeType id="LLN01" lnClass="LLN0">
      <DO name="Mod" type="INC_1_Mod" />
      <DO name="Beh" type="INS_1_Beh" />
      <DO name="Health" type="INS_1_Beh" />
      <DO name="NamPlt" type="LPL_1_NamPlt" />
    </LNodeType>

    <LNodeType id="LPHD1" lnClass="LPHD">
      <DO name="PhyNam" type="DPL_1_PhyNam" />
      <DO name="PhyHealth" type="INS_1_Beh" />
      <DO name="Proxy" type="SPS_1_Proxy" />
    </LNodeType>

    <LNodeType id="GGIO1" lnClass="GGIO">
      <DO name="Mod" type="INC_1_Mod" />
      <DO name="Beh" type="INS_1_Beh" />
      <DO name="Health" type="INS_1_Beh" />
      <DO name="NamPlt" type="LPL_2_NamPlt" />
      <DO name="AnOut1" type="APC_1_AnOut" />
      <DO name="AnOut1Fb" type="MV_1_Fb" />
      <DO name="AnOut2" type="APC_1_AnOut" />
      <DO name="AnOut2Fb" type="MV_1_Fb" />
    </LNodeType>

    <DOType id="INC_1_Mod" cdc="INC">
      <DA name="stVal" bType="INT32" fc="ST" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
      <DA name="ctlModel" type="CtlModels" bType="Enum" fc="CF" />
    </DOType>

    <DOType id="INS_1_Beh" cdc="INS">
      <DA name="stVal" bType="INT32" fc="ST" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>

    <DOType id="LPL_1_NamPlt" cdc="LPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
      <DA name="swRev" bType="VisString255" fc="DC" />
      <DA name="d" bType="VisString255" fc="DC" />
      <DA name="configRev" bType="VisString255" fc="DC" />
      <DA name="ldNs" bType="VisString255" fc="EX" />
    </DOType>

    <DOType id="LPL_2_NamPlt" cdc="LPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
      <DA name="swRev" bType="VisString255" fc="DC" />
      <DA name="d" bType="VisString255" fc="DC" />
    </DOType>

    <DOType id="DPL_1_PhyNam" cdc="DPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
    </DOType>

    <DOType id="SPS_1_Proxy" cdc="SPS">
      <DA name="stVal" bType="BOOLEAN" fc="ST" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>

    <!-- 遥调目标：模拟量设定值（APC），带 Oper / mxVal / ctlModel -->
    <DOType id="APC_1_AnOut" cdc="APC">
      <DA name="Oper" type="APCOperate_1" bType="Struct" fc="CO" />
      <DA name="mxVal" type="AnalogueValue_1" bType="Struct" fc="MX" dchg="true" />
      <DA name="q" bType="Quality" fc="MX" qchg="true" />
      <DA name="t" bType="Timestamp" fc="MX" />
      <DA name="ctlModel" type="CtlModels" bType="Enum" fc="CF" />
    </DOType>

    <!-- 模拟实际输出：测量值（MV），由服务端跟随设定值刷新 -->
    <DOType id="MV_1_Fb" cdc="MV">
      <DA name="mag" type="AnalogueValue_1" bType="Struct" fc="MX" dchg="true" />
      <DA name="q" bType="Quality" fc="MX" qchg="true" />
      <DA name="t" bType="Timestamp" fc="MX" />
    </DOType>

    <!-- APC 的 Oper：ctlVal 是 AnalogueValue 结构体，不是裸 FLOAT32 -->
    <DAType id="APCOperate_1">
      <BDA name="ctlVal" type="AnalogueValue_1" bType="Struct" />
      <BDA name="origin" type="Originator_1" bType="Struct" />
      <BDA name="ctlNum" bType="INT8U" />
      <BDA name="T" bType="Timestamp" />
      <BDA name="Test" bType="BOOLEAN" />
      <BDA name="Check" bType="Check" />
    </DAType>

    <DAType id="Originator_1">
      <BDA name="orCat" type="OrCat" bType="Enum" />
      <BDA name="orIdent" bType="Octet64" />
    </DAType>

    <!--
      数据集成员指向的是叶子 mxVal.f / mag.f，所以 dchg / dupd 必须声明在
      叶子（这里的 BDA f）上。生成器只会把 DA/BDA 自己声明的触发位写进模型，
      声明在父结构 mxVal / mag 上的 dchg 不会被叶子继承。
      服务端检测变位只看"被 update 的那个属性自己的 triggerOptions"
      （ied_server.c checkForChangedTriggers），叶子为 0 就不会有变位报告，
      只剩 GI 和周期报告——这正是"值变了却收不到 dchg"的根因。
      dupd 打开后，写同样的值也会产生一次 data-update 报告。
    -->
    <DAType id="AnalogueValue_1">
      <BDA name="f" bType="FLOAT32" dchg="true" dupd="true" />
    </DAType>

    <EnumType id="CtlModels">
      <EnumVal ord="0">status-only</EnumVal>
      <EnumVal ord="1">direct-with-normal-security</EnumVal>
      <EnumVal ord="2">sbo-with-normal-security</EnumVal>
      <EnumVal ord="3">direct-with-enhanced-security</EnumVal>
      <EnumVal ord="4">sbo-with-enhanced-security</EnumVal>
    </EnumType>

    <EnumType id="OrCat">
      <EnumVal ord="0">not-supported</EnumVal>
      <EnumVal ord="1">bay-control</EnumVal>
      <EnumVal ord="2">station-control</EnumVal>
      <EnumVal ord="3">remote-control</EnumVal>
      <EnumVal ord="4">automatic-bay</EnumVal>
      <EnumVal ord="5">automatic-station</EnumVal>
      <EnumVal ord="6">automatic-remote</EnumVal>
      <EnumVal ord="7">maintenance</EnumVal>
      <EnumVal ord="8">process</EnumVal>
    </EnumType>
  </DataTypeTemplates>
</SCL>
